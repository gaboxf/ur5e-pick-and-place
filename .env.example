# ==============================================================
# ur5e-pick-and-place — plantilla de configuración
# --------------------------------------------------------------
# Copiá este archivo como .env y completá los valores según tu
# setup:  cp .env.example .env
# ==============================================================

# IP del robot UR5e.
#   127.0.0.1        -> URSim en Docker (desarrollo local)
#   192.168.1.10     -> UR5 real del laboratorio
UR5_IP=127.0.0.1

# Puerto RTDE. ur_rtde usa siempre 30004 (esta variable es informativa).
UR5_RTDE_PORT=30004

# Timeout de conexión al robot (segundos)
UR5_TIMEOUT=5.0

# Puerto serial del Arduino (gripper)
# En Windows suele ser COM3, COM4, etc.
# En Linux/Mac: /dev/ttyUSB0, /dev/ttyACM0
GRIPPER_PORT=/dev/ttyUSB0

# Baudrate del gripper
GRIPPER_BAUDRATE=115200

# Índice de la cámara USB (0 = cámara por defecto)
CAMERA_INDEX=0

# Modo de operación: real | mock | sim
#   real  -> usa ur_rtde y puerto serial reales (incluye URSim)
#   mock  -> simula robot pero usa hardware real de cámara y gripper
#   sim   -> simula todo (para desarrollo sin hardware)
ROBOT_MODE=real

# Velocidad del robot (rad/s o m/s según trayectoria)
ROBOT_VEL=0.25

# Aceleración del robot (rad/s² o m/s²)
ROBOT_ACC=1.25

# Tiempo de espera entre movimientos (segundos) para modos mock/sim
MOCK_DELAY=1.0

# ---------------------------------------------------------------------------
# Logs de corrida (opcional). Ver core/logging_config.py y tools/gestionar_logs.py
# ---------------------------------------------------------------------------
# Guardar los logs de cada corrida en logs/corrida_FECHA_HORA.log
#LOG_ARCHIVO=1
# Carpeta destino (por defecto: <proyecto>/logs)
#LOG_DIR=logs
# Cuántas corridas viejas conservar (0 = no borrar nunca; default 10)
#LOG_RETENCION=10
# Nivel de detalle de la consola (INFO default; DEBUG para diagnosticar)
#LOG_LEVEL=INFO

# ---------------------------------------------------------------------------
# Claves API (NO pongas valores reales en este archivo)
# ---------------------------------------------------------------------------
# Ejemplo de formato para claves que uses en el proyecto:
# MI_API_KEY=xxxx-xxxx-xxxx
